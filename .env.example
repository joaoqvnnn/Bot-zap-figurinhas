# ==============================================
# LARI MYSTIC BOT - VARIÁVEIS DE AMBIENTE
# ==============================================

# ---------- NÚMERO DO DONO ----------
# Número do dono no formato internacional, sem "+", apenas dígitos.
# Exemplo: 5511999999999
OWNER_NUMBER=5511999999999

# ---------- TOKEN SECRETO DO GRUPO ----------
# Token único que o dono/admins usam para acessar áreas restritas.
TOKEN_GRUPO=abc123xyz

# ---------- BANCO DE DADOS (MongoDB) ----------
MONGODB_URI=mongodb+srv://usuario:senha@cluster0.mongodb.net/lari-mystic

# ---------- API DE INTELIGÊNCIA ARTIFICIAL ----------
# Opcional, se quiser usar IA. Ex: OpenAI, HuggingFace.
IA_API_KEY=
IA_API_URL=

# ---------- NÍVEL DE LOG ----------
LOG_LEVEL=info
